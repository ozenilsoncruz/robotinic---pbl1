// Definicao dos motores ativos
#define MOTOR_GARRA OUT_B
#define MOTOR_DIREITO OUT_A
#define MOTOR_ESQUERDO OUT_C
#define MOTOR_DIREITO_ESQUERDO OUT_AC

// Definicao dos sensores ativos
#define SENSOR_COR S3
#define SENSOR_TOQUE S1
#define SENSOR_TOQUE_2 S4
#define SENSOR_ULTRASSOM S2

// Canal de comunica??o Bluetooth
#define MAILBOX_RECIVE 1
#define MAILBOX_SEND 2

// Potencias dos motores
#define VELOCIDADE_MAXIMA 100
#define VELOCIDADE_MEDIA 30
#define VELOCIDADE_MINIMA 15

// Distancia para deteccao de obstaculos
#define DISTANCIA_OBSTACULO 25

// Cores usadas
#define PRETO 1
#define PRATA 2
#define BRANCO 3
#define VERMELHO 4


// Medidas do rob?
#define DIAMETRO_RODA 5.5
#define DISTANCIA_ENTRE_RODAS 18.5


float distanciaPercorrer = 0;

int corDetectada = 0;

mutex motorDireitoEsquerdoMutex;

void enviarMensagem(string msg) {
    SendMessage(MAILBOX_SEND, msg);
}

void girarMotoresGraus(float graus) {
    int graus_motor = abs(graus)           // Quantos graus os motores devem girar
    int direcao = graus > 0 ? 1 : -1;     // Determina a direção do movimento

    ResetRotationCount(MOTOR_ESQUERDO);
    ResetRotationCount(MOTOR_DIREITO);

    // posição inicial de ambos os motores
    int pos_inicial_esquerdo = MotorRotationCount(MOTOR_ESQUERDO);
    int pos_inicial_direito = MotorRotationCount(MOTOR_DIREITO);

    OnFwdSyncEx(MOTOR_DIREITO_ESQUERDO, VELOCIDADE_MEDIA, 100 * direcao, RESET_COUNT);

    while (true) {
        int pos_atual_esquerdo = MotorRotationCount(MOTOR_ESQUERDO);
        int pos_atual_direito = MotorRotationCount(MOTOR_DIREITO);

        bool esquerdo_pronto = abs(pos_atual_esquerdo - pos_inicial_esquerdo) >= graus_motor;
        bool direito_pronto = abs(pos_atual_direito - pos_inicial_direito) >= graus_motor;

        if (esquerdo_pronto && direito_pronto) {
            Off(MOTOR_DIREITO_ESQUERDO);
            break;
        }
        Wait(10);
    }
}

void girarMotoresVoltas(float num_voltas, bool frente = true) {
    int graus_motor = 360 * num_voltas;  // Quantos graus os motores devem girar
    int direcao = frente ? 1 : -1;      // Determina a direção do movimento

    ResetRotationCount(MOTOR_ESQUERDO);
    ResetRotationCount(MOTOR_DIREITO);

    // posição inicial de ambos os motores
    int pos_inicial_esquerdo = MotorRotationCount(MOTOR_ESQUERDO);
    int pos_inicial_direito = MotorRotationCount(MOTOR_DIREITO);

    OnFwdReg(MOTOR_DIREITO_ESQUERDO, VELOCIDADE_MEDIA * direcao, OUT_REGMODE_SYNC);

    while (true) {
        int pos_atual_esquerdo = MotorRotationCount(MOTOR_ESQUERDO);
        int pos_atual_direito = MotorRotationCount(MOTOR_DIREITO);

        bool esquerdo_pronto = abs(pos_atual_esquerdo - pos_inicial_esquerdo) >= graus_motor;
        bool direito_pronto = abs(pos_atual_direito - pos_inicial_direito) >= graus_motor;

        if (esquerdo_pronto && direito_pronto) {
            Off(MOTOR_DIREITO_ESQUERDO);
            break;
        }
        Wait(10);
    }
}

void acionarMotores(bool frente=true) {
    int direcao = frente ? 1 : -1;
    OnFwdReg(MOTOR_DIREITO_ESQUERDO, VELOCIDADE_MEDIA * direcao, OUT_REGMODE_SYNC);
}



void girarEmGraus(int grausRotacao) {
    int graus = grausRotacao > 0 ? grausRotacao - 19 : grausRotacao + 19;
    
    int direcao = graus > 0 ? 1 : -1; // Determina a direção do giro
    float distancia_percorrida = (DISTANCIA_ENTRE_RODAS * PI * abs(graus));
    float numero_rotacoes = distancia_percorrida / (PI * DIAMETRO_RODA);
    int graus_motor = numero_rotacoes;

    ResetRotationCount(MOTOR_ESQUERDO);
    ResetRotationCount(MOTOR_DIREITO);

    // Posição inicial dos motores
    int pos_inicial_esquerdo = MotorRotationCount(MOTOR_ESQUERDO);
    int pos_inicial_direito = MotorRotationCount(MOTOR_DIREITO);

    OnFwdSyncEx(MOTOR_DIREITO_ESQUERDO, VELOCIDADE_MEDIA, 100 * direcao, RESET_COUNT);

    while (true) {
        int pos_atual_esquerdo = MotorRotationCount(MOTOR_ESQUERDO);
        int pos_atual_direito = MotorRotationCount(MOTOR_DIREITO);

        // Verificar se ambos os motores atingiram a rotação desejada
        bool esquerdo_pronto = abs(pos_atual_esquerdo - pos_inicial_esquerdo) >= graus_motor;   
        bool direito_pronto = abs(pos_atual_direito - pos_inicial_direito) >= graus_motor;

        if (esquerdo_pronto && direito_pronto) {
            // Parar os motores
            Off(MOTOR_ESQUERDO);
            Off(MOTOR_DIREITO);
            break;
        }
        Wait(10); // Pequeno atraso para evitar uso excessivo de CPU
    }
}


// Fun??o para andar uma determinada dist?ncia em cent?metros.
void andarPorCm(float distancia) {
    float circunferencia_roda = PI * DIAMETRO_RODA;
    float numero_rotacoes = distancia / circunferencia_roda;
    bool frente = distancia > 0;
    girarMotoresVoltas(numero_rotacoes, frente);
}

void andarFrente() {
    acionarMotores();
}

void frear() {
    Off(MOTOR_DIREITO_ESQUERDO);
}

void girarDireita() {
    girarEmGraus(-90);
}

void girarEsquerda() {
    girarEmGraus(90);
}

void girar180() {
    girarEmGraus(90);
    Wait(100);
    girarEmGraus(90);
}

void contornarObstaculo() {
    while(true) {
        Acquire(motorDireitoEsquerdoMutex);
        if (Sensor(SENSOR_TOQUE) == 1) {
            frear();
            andarPorCm(-10);
            girarDireita();
            Wait(100);
            andarPorCm(10);
            girarEsquerda();
            Wait(100);
            andarPorCm(10);
        }
        Release(motorDireitoEsquerdoMutex);
    }
}


// Executa ações recebidas do supervisor
task executarAcoesSupervisor() {
    string msg = "";

    while (true) {
        // Recebe a mensagem via Bluetooth
        ReceiveMessage(MAILBOX_RECIVE, true, msg);
        //Tipo de mensagem esperada -> M:10,R:90,P:1000
        msg = "M:10";
        if (msg != "") {
            Acquire(motorDireitoEsquerdoMutex);
           TextOut(0, LCD_LINE1, "Msg");
            int startStr = 0;
            int len = StrLen(msg);

            while (startStr < len) {
                int commaPos = StrLen(msg) - startStr;
                for (int i = startStr; i < len; i++) {
                    if (StrIndex(msg, i) == ',') {
                        commaPos = i - startStr;
                        break;
                    }
                }

                string commandPair = SubStr(msg, startStr, commaPos);

                int colonPos = StrLen(commandPair);
                for (int i = 0; i < StrLen(commandPair); i++) {
                    if (StrIndex(commandPair, i) == ':') {
                        colonPos = i;
                        break;
                    }
                }

                string command = SubStr(commandPair, 0, colonPos);
                float value = StrToNum(SubStr(commandPair, colonPos + 1, StrLen(commandPair) - (colonPos + 1)));

                // Execute the command
                if (command == "M") {
                    TextOut(0, LCD_LINE1, "Movendo: " + NumToStr(value) + " cm");
                    andarPorCm(value);
                } else if (command == "R") {
                    TextOut(0, LCD_LINE1, "Rodando: " + NumToStr(value) + " graus");
                    girarEmGraus(value);
                } else {
                    TextOut(0, LCD_LINE1, "Comando inválido");
                }
                
                startStr += commaPos + 1;
            }

            msg = "";
        }
        Release(motorDireitoEsquerdoMutex);
        Wait(50);
    }
}



string lerCor(int cor) {
    if (cor == 1) {
        return "Preto";
    }
    else if (cor == 2) {
        return "Prata";
    }
    else if (cor == 3) {
        return "Branco";
    }
    else return "Unknown";
}

task enviarOdometria() {
    while(true) {
        float motorDireitoCount = MotorRotationCount(MOTOR_DIREITO);
        float motorEsquerdoCount = MotorRotationCount(MOTOR_ESQUERDO);
        string msg = NumToStr(motorEsquerdoCount) + "," + NumToStr(motorDireitoCount);
        enviarMensagem(msg);
        ResetRotationCount(MOTOR_DIREITO);
        ResetRotationCount(MOTOR_ESQUERDO);
        Wait(500);
    }
}

task mostrarInformacoes() {
    while(true) {
        ClearScreen();
        float motorDireitoCount = MotorRotationCount(MOTOR_DIREITO)/360;
        float motorEsquerdoCount = MotorRotationCount(MOTOR_ESQUERDO)/360;
        int distancia = SensorUS(SENSOR_ULTRASSOM);
        int valorLuz = Sensor(SENSOR_COR);
        TextOut(0, LCD_LINE1, "Dis:" + NumToStr(distancia));
        TextOut(0, LCD_LINE2, "Cor:" + lerCor(corDetectada) + " V:" + NumToStr(valorLuz));
        TextOut(0, LCD_LINE3, "D:" + NumToStr(motorDireitoCount) + " E:" + NumToStr(motorEsquerdoCount));
        TextOut(0, LCD_LINE4, "Per" + NumToStr(distanciaPercorrer));
       
        Wait(100);
    }
}




task detectarCor() {
    while (true) {
        int valorLuz = Sensor(SENSOR_COR);
        if (valorLuz < 40) {
            corDetectada = PRETO;
        }
        else if (valorLuz >= 40 && valorLuz < 65) {
            corDetectada = BRANCO;
        }
        else if (valorLuz >= 65) {
            corDetectada = PRATA;
        }
        Wait(100);
    }
}



task main() {
    SetSensorLight(SENSOR_COR);
    SetSensorTouch(SENSOR_TOQUE);
    SetSensorUltrasonic(SENSOR_ULTRASSOM);


    StartTask(executarAcoesSupervisor);
    contornarObstaculo();  
}
