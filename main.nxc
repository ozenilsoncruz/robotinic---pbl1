// Definicao dos motores ativos
#define MOTOR_GARRA OUT_B
#define MOTOR_DIREITO OUT_A
#define MOTOR_ESQUERDO OUT_C
#define MOTOR_DIREITO_ESQUERDO OUT_AC

// Definicao dos sensores ativos
#define SENSOR_COR S3
#define SENSOR_TOQUE S1
#define SENSOR_TOQUE_2 S4
#define SENSOR_ULTRASSOM S2

// Canal de comunica??o Bluetooth
#define MAILBOX_RECIVE 1
#define MAILBOX_SEND 2

// Potencias dos motores
#define VELOCIDADE_MAXIMA 100
#define VELOCIDADE_MEDIA 45
#define VELOCIDADE_MINIMA 30

// Distancia para deteccao de obstaculos
#define DISTANCIA_OBSTACULO 25

// Cores usadas
#define PRETO 1
#define PRATA 2
#define BRANCO 3
#define VERMELHO 4


// Medidas do rob?
#define DIAMETRO_RODA 5.5
#define DISTANCIA_ENTRE_RODAS 18.5


enum Estado {
    SAIR_BASE,
    MOVER_PARA_ESTOQUE,
    PROCURAR_OBJETO,
    SAIR_ESTOQUE,
    PROCURAR_ESTACAO_TRABALHO,
    ENTRAR_ESTACAO_TRABALHO,
    ESTACAO_TRABALHO,
    ACHAR_OUTRA_ESTACAO_TRABALHO,
    SAIR_ESTACAO_TRABALHO,
    RETORNAR_BASE
};

Estado estadoAtual;

// Vari?veis globais
float x = 0;
float y = 0;
float angulo = 0;

int corDetectada = 0;
bool deveGirarDireita = false; // Vari?vel para indicar se o rob? deve girar para a direita ou esquerda
bool procurarObjeto = false;
bool objetoAdquirido = false;
bool detectarVermelho = false;
int estacoesTrabalho = 0;


float deslocamento_medio = 0;

mutex motorDireitoEsquerdoMutex;

void enviarMensagem(string msg) {
    SendMessage(MAILBOX_SEND, msg);
}

void calcularOdometria(int compensacao = 0) {
    float motorDireitoCount = MotorRotationCount(MOTOR_DIREITO)/360;
    float motorEsquerdoCount = MotorRotationCount(MOTOR_ESQUERDO)/360;
    float deslocamento_motor_direito = motorDireitoCount * PI * (DIAMETRO_RODA);
    float deslocamento_motor_esquerdo = motorEsquerdoCount * PI * (DIAMETRO_RODA);
    deslocamento_medio = ((deslocamento_motor_direito) + (deslocamento_motor_esquerdo)) / 2;
    float mudanca_angulo = (deslocamento_motor_direito - deslocamento_motor_esquerdo) / (DISTANCIA_ENTRE_RODAS);

    angulo += (mudanca_angulo + (compensacao/57.2958));

    float delta_x = deslocamento_medio * Cos(angulo);
    float delta_y = deslocamento_medio * Sin(angulo);

    // Convertendo para cent?metros
    x = delta_x / 100;
    y = delta_y / 100;

    string msg = NumToStr(x) + "," + NumToStr(y) + "," + NumToStr(angulo);
    enviarMensagem(msg);
    ResetRotationCount(MOTOR_DIREITO);
    ResetRotationCount(MOTOR_ESQUERDO);
    Wait(100);
}


void acionarMotor(int motor, float num_voltas, bool frente=true) {

    int graus_motor = 360 * num_voltas;  // Quantos graus o motor deve girar

    if (frente) {
        RotateMotorEx(motor, VELOCIDADE_MEDIA, graus_motor, 0, true, true);
    }
    else {
        RotateMotorEx(motor, -VELOCIDADE_MEDIA, graus_motor, 0, true, true);

    }
    calcularOdometria();

}


void acionarMotores(bool frente=true) {
    if(frente) {
        // TODO: testar se o rob? caminha reto
        OnFwdSync(MOTOR_DIREITO_ESQUERDO, VELOCIDADE_MEDIA, 0);
    }
    else {
        OnRevSync(MOTOR_DIREITO_ESQUERDO, VELOCIDADE_MEDIA, 0);
    }
}



void girarEmGraus(int grausRotacao) {
    int graus = grausRotacao > 0 ? grausRotacao - 10 : grausRotacao + 8;
    float distancia_percorrida = (DISTANCIA_ENTRE_RODAS * PI * abs(graus)) / 360.0;
    float numero_rotacoes = distancia_percorrida / (PI * DIAMETRO_RODA);
    int graus_motor = 360 * numero_rotacoes;

    if (graus > 0) {
        RotateMotorEx(MOTOR_DIREITO_ESQUERDO, VELOCIDADE_MEDIA, graus_motor, -100, true, true);
    } else {
        // Girar para a direita
        RotateMotorEx(MOTOR_DIREITO_ESQUERDO, VELOCIDADE_MEDIA, graus_motor, 100, true, true);
    }
    calcularOdometria(grausRotacao - graus);
}

// Fun??o para andar uma determinada dist?ncia em cent?metros.
void andarPorCm(float distancia, bool frente=true) {
    float circunferencia_roda = PI * DIAMETRO_RODA;
    float numero_rotacoes = distancia / circunferencia_roda;
    acionarMotor(MOTOR_DIREITO_ESQUERDO, numero_rotacoes, frente);
}

void andarFrente() {
    acionarMotores();
}

void andarFrenteUmaVez() {
    acionarMotor(MOTOR_DIREITO_ESQUERDO, 1);
}

void andarFrenteNumeroVezes(float vezes) {
    acionarMotor(MOTOR_DIREITO_ESQUERDO, vezes);
}

void andarTras() {
    acionarMotores(false);
}

void andarTrasUmaVez() {
    acionarMotor(MOTOR_DIREITO_ESQUERDO, 0.5, false);
}

void andarTrasNumeroVezes(float vezes) {
    acionarMotor(MOTOR_DIREITO_ESQUERDO, vezes, false);
}

void frear() {
    Off(MOTOR_DIREITO_ESQUERDO);
    calcularOdometria();
}

void girarDireita() {
    girarEmGraus(-90);
}

void girarEsquerda() {
    girarEmGraus(90);
}

void girar180() {
    girarEmGraus(180);
}

void acionarGarra() {
    OnRev(MOTOR_GARRA, VELOCIDADE_MINIMA);
    Wait(1000);
    Off(MOTOR_GARRA);
}

void liberarGarra() {
    RotateMotor(MOTOR_GARRA, VELOCIDADE_MINIMA, 75);
}


bool pegarObjeto() {
    int valor = SensorUS(SENSOR_ULTRASSOM);
    if (valor < DISTANCIA_OBSTACULO) {
        frear();
        andarPorCm(valor);
        if((Sensor(SENSOR_TOQUE) == 0 && Sensor(SENSOR_TOQUE_2) == 0)) {
            acionarGarra();
            return true;
        }
    }
    return false;
}

string lerCor(int cor) {
    if (cor == 1) {
        return "Preto";
    }
    else if (cor == 2) {
        return "Prata";
    }
    else if (cor == 3) {
        return "Branco";
    }
    else return "Unknown";
}

task mostrarInformacoes() {
    while(true) {
        ClearScreen();
        float motorDireitoCount = MotorRotationCount(MOTOR_DIREITO)/360;
        float motorEsquerdoCount = MotorRotationCount(MOTOR_ESQUERDO)/360;
        int distancia = SensorUS(SENSOR_ULTRASSOM);
        int valorLuz = Sensor(SENSOR_COR);
        TextOut(0, LCD_LINE1, "Dis:" + NumToStr(distancia) + " Obj:" + NumToStr(objetoAdquirido));
        TextOut(0, LCD_LINE2, "Cor:" + lerCor(corDetectada) + " V:" + NumToStr(valorLuz));
        TextOut(0, LCD_LINE3, "Estado:" + NumToStr(estadoAtual));
        TextOut(0, LCD_LINE4, "D:" + NumToStr(motorDireitoCount) + " E:" + NumToStr(motorEsquerdoCount));
        TextOut(0, LCD_LINE5, "X:" + NumToStr(x));
        TextOut(0, LCD_LINE6, "Y:" + NumToStr(y));
        TextOut(0, LCD_LINE7, "Angulo: " + NumToStr(angulo * 57.2958));
        TextOut(0, LCD_LINE8, "Garra: " + NumToStr(MotorRotationCount(MOTOR_GARRA)));
        Wait(100);
    }
}


task detectarParede() {
    while (true) {
        Acquire(motorDireitoEsquerdoMutex);
        if (Sensor(SENSOR_TOQUE) == 1 || Sensor(SENSOR_TOQUE_2) == 1) {
            andarPorCm(10, false);
            girarDireita();
        }
        Release(motorDireitoEsquerdoMutex);
    }
}


task explorar() {
    while (true) {
        Acquire(motorDireitoEsquerdoMutex);
        if(procurarObjeto) {
            andarFrente();
            if(pegarObjeto()) {
                objetoAdquirido = true;
            }
            // frear();
            // girarEmGraus(-45);
            // if(pegarObjeto()) continue;
            // girarEmGraus(90);
            // if(pegarObjeto()) continue;
            // girarEmGraus(-45);
        }
        Wait(100);
        Release(motorDireitoEsquerdoMutex);
    }
}



task detectarCor() {
    // TODO: Implementar l?gica para detectar a cor vermelha
    // SetSensorLight(SENSOR_COR, false);
    while (true) {
        int valorLuz = Sensor(SENSOR_COR);
        if (valorLuz >= 21 && valorLuz < 27 && detectarVermelho) {
            corDetectada = VERMELHO;
        }
        else if (valorLuz < 40) {
            corDetectada = PRETO;
        }
        else if (valorLuz >= 40 && valorLuz < 65) {
            corDetectada = BRANCO;
        }
        else if (valorLuz >= 65) {
            corDetectada = PRATA;
        }
        Wait(100);
    }
}


// Fun??o principal de atualiza??o de estado
task atualizarEstado() {
    estadoAtual = SAIR_BASE;
    while (true) {
        Acquire(motorDireitoEsquerdoMutex);
        switch (estadoAtual) {
            case SAIR_BASE: //Estado OK!
                if (corDetectada == PRATA) {
                    frear();
                    andarFrente();
                    Wait(1000);
                    estadoAtual = MOVER_PARA_ESTOQUE;
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                else if (corDetectada == PRETO) {
                    frear();
                    andarTrasUmaVez();
                    girarDireita();
                    andarFrenteUmaVez();
                    girarEsquerda();
                }
                break;
            case MOVER_PARA_ESTOQUE: //Estado OK!
                if (corDetectada == PRATA) {
                    frear();
                    andarPorCm(20);
                    girarDireita();
                    estadoAtual = PROCURAR_OBJETO;
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                else if (corDetectada == PRETO) {
                    frear();
                    andarPorCm(10, false);
                    girarDireita();
                    andarPorCm(10);
                    girarEsquerda();
                }
                break;
            case PROCURAR_OBJETO: //Estado OK!
                procurarObjeto = true;
                if (objetoAdquirido) {
                    procurarObjeto = false;
                    girarEsquerda();
                    //girarDireita();
                    estadoAtual = SAIR_ESTOQUE;
                }
                else if(corDetectada == PRATA || corDetectada == PRETO) {
                    frear();
                    andarPorCm(10, false);
                    girarDireita();
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                break;
            case SAIR_ESTOQUE: //Estado OK!
                if (corDetectada == PRATA) {
                    frear();
                    andarPorCm(25);
                    girarEsquerda();
                    //girarDireita();
                    estadoAtual = PROCURAR_ESTACAO_TRABALHO;
                    andarFrente();
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                else if (corDetectada == PRETO) {
                    frear();
                    andarPorCm(10, false);
                    girarDireita();
                    andarPorCm(10);
                    girarEsquerda();
                }
                break;
            case PROCURAR_ESTACAO_TRABALHO:
                if (corDetectada == PRATA) {
                    andarFrente();
                    estadoAtual = ESTACAO_TRABALHO;
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                else if (corDetectada == PRETO) {
                    frear();
                    andarPorCm(10, false);
                    girarDireita();
                    andarPorCm(30);
                    girarEsquerda();
                    andarPorCm(10);
                    girarEsquerda();
                    estadoAtual = ENTRAR_ESTACAO_TRABALHO;
                }
                break;
            case ENTRAR_ESTACAO_TRABALHO:
                if (corDetectada == PRATA) {
                    andarFrente();
                    estadoAtual = ESTACAO_TRABALHO;
                    //andarPorCm(10);
                    //liberarGarra();
                    //andarPorCm(10, false);
                    //girarDireita();
                    //estadoAtual = RETORNAR_BASE;
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                else if (corDetectada == PRETO) {
                    frear();
                    andarTrasUmaVez();
                    girarDireita();
                    andarPorCm(5);
                    girarEsquerda();
                }
                break;
            case ESTACAO_TRABALHO:
                SetSensorLight(SENSOR_COR, false); // NOTE: N?o vi muita diferen?a com a luz desligada, a diferen?a do vermelho e do branco continua pequena
                detectarVermelho = true;
                if (corDetectada == VERMELHO) {
                    frear();
                    andarTrasUmaVez();
                    girar180();
                    estadoAtual = ACHAR_OUTRA_ESTACAO_TRABALHO;
                    SetSensorLight(SENSOR_COR, true);
                    estacoesTrabalho++;
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                else if (corDetectada == PRETO) {
                    frear();
                    andarTrasUmaVez();
                    liberarGarra();
                    girarDireita();
                    andarFrente();
                    estadoAtual = SAIR_ESTACAO_TRABALHO;
                    SetSensorLight(SENSOR_COR, true);
                }
                break;
            case ACHAR_OUTRA_ESTACAO_TRABALHO:
                if(estacoesTrabalho == 1) {
                    if (corDetectada == PRATA) {
                        frear();
                        andarFrente();
                        deveGirarDireita = true;
                        estadoAtual = ESTACAO_TRABALHO;
                    }
                    else if(corDetectada == BRANCO) {
                        andarFrente();
                    }
                    else if (corDetectada == PRETO) {
                        frear();
                        andarPorCm(10, false);
                        girarDireita();
                        andarPorCm(10);
                        girarEsquerda();
                    }
                }
                // TODO: Implementar l?gica para achar outras esta??o de trabalho, por enquanto s? a primeira e segunda
                break;
            case SAIR_ESTACAO_TRABALHO:
                if (corDetectada == PRATA) {
                    frear();
                    andarFrenteUmaVez();
                    if(deveGirarDireita) {
                        girarDireita();
                    }
                    else {
                        girarEsquerda();
                    }
                    estadoAtual = RETORNAR_BASE;
                    andarFrente();
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                else if (corDetectada == PRETO) {
                    frear();
                    andarTrasUmaVez();
                    girarDireita();
                }
                break;
            case RETORNAR_BASE:
                if (corDetectada == PRATA) {
                    frear();
                    andarFrenteUmaVez();
                    girarEmGraus(360);
                    girar180();
                }
                else if(corDetectada == BRANCO) {
                    andarFrente();
                }
                else if (corDetectada == PRETO) {
                    frear();
                    andarTrasUmaVez();
                    girarDireita();
                    andarFrenteUmaVez();
                    girarEsquerda();
                }
                break;
        }
        Release(motorDireitoEsquerdoMutex);
    }
}

task main() {
    SetVolume(100);
    SetSensorLight(SENSOR_COR);
    SetSensorTouch(SENSOR_TOQUE);
    SetSensorUltrasonic(SENSOR_ULTRASSOM);
    PlaySound(SOUND_FAST_UP);

    // string msg = "";
    // while(msg == "") {
    //     ReceiveMessage(MAILBOX_RECIVE, true, msg);
    // }


    while(Sensor(SENSOR_TOQUE) == 0) {};
    Precedes(mostrarInformacoes, detectarCor, detectarParede, explorar, atualizarEstado);
    }













































